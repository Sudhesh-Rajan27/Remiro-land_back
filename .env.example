PORT=4000
JWT_SECRET=replace_with_strong_secret
MONGODB_URI=mongodb://localhost:27017/remiro_auth

# Google OAuth credentials from Google Cloud Console
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Must match frontend OAuth redirect and Google Console authorized redirect URI
# Current backend default in server.js is http://localhost:5173
# (used in OAuth2Client redirect_uri)

# Cloudinary (profile picture uploads)
# Prefer a single CLOUDINARY_URL value:
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# Or set individual fields:
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

